{
  "name": "Pocket Blog",
  "short_name": "Blog",
  "description": "Your own blog without any programming: write, pick a look, publish. Pocket AI helps you write.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#3157d5",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Write a post",
      "url": "/write"
    },
    {
      "name": "Drafts",
      "url": "/posts?status=draft"
    },
    {
      "name": "Comments",
      "url": "/comments"
    }
  ]
}
